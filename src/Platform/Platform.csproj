<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZeroAlloc.Platform</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Description>Zero-allocation OS primitives for .NET 10: POSIX/Win32 shared memory maps, RDTSC monotonic clocks, futex/semaphore thread parkers, CPU core affinity pinning, and high-resolution timer scopes.</Description>
    <PackageTags>platform;os;shared-memory;mmap;rdtsc;threading;affinity;zero-allocation;unsafe;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Tests" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
