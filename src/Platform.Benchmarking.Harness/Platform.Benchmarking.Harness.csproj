<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZeroAlloc.Platform.Benchmarking</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Description>Low-level mechanical-sympathy benchmarking harness: pinned worker threads, open-loop pacers, seqlock metrics readers, and unmanaged linear histograms.</Description>
    <PackageTags>benchmarking;performance;latency;histogram;pacer;zero-allocation;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <ProjectReference Include="..\Platform\Platform.csproj" />
  </ItemGroup>
</Project>
