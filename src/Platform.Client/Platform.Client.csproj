<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZeroAlloc.Platform.Client</PackageId>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Description>Managed, Unity/Mono/IL2CPP-safe runtime primitives (monotonic ClientClock, managed ThreadParker, ClientDiagnostics) for .NET 10 and netstandard2.1.</Description>
    <PackageTags>platform;client;unity;netstandard2.1;clock;threading;zero-allocation;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="ZeroAlloc.Memory" />
  </ItemGroup>
</Project>
